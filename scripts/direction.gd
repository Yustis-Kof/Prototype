class_name Direction
extends Object
## Набор констант для направлений на ортогональном поле

const NW = Vector2(-1, -1)
const N = Vector2(0, -1)
const NE = Vector2(1, -1)
const W = Vector2(-1, 0)
const E = Vector2(1, 0)
const SW = Vector2(-1, 1)
const S = Vector2(0, 1)
const SE = Vector2(1, 1)

const ALL : Array[Vector2] = [E, SE, S, SW, W, NE, N, NW]
